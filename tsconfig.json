{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"],
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/tokens/*": [
        "./src/tokens/*"
      ],
      "@/styles/*": [
        "./src/styles/*"
      ],
      "@/utils/*": [
        "./src/utils/*"
      ],
      "@/compenents/*": [
        "./src/compenents/*"
      ],
      "@/public/*": [
        "./src/public/*"
      ]    
    },
  },
  
  "include": ["src"]
}